# ─────────────────────────────────────────────
# Turso (libSQL) 資料庫
# 取得方式：turso db show bobibo-ink / turso db tokens create bobibo-ink
# ─────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-token

# ─────────────────────────────────────────────
# Cloudflare R2 圖片儲存
# 取得方式：Cloudflare Dashboard → R2 → Manage R2 API Tokens
# ─────────────────────────────────────────────
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=bobibo-ink-images
# 公開讀取網址，例如 https://pub-xxxxxx.r2.dev
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
# 上面網址的 hostname（給 next.config.js 的 images 白名單用），例如 pub-xxxxxx.r2.dev
R2_PUBLIC_HOSTNAME=pub-xxxxxx.r2.dev

# ─────────────────────────────────────────────
# Admin 後台
# ─────────────────────────────────────────────
ADMIN_PASSWORD=change-me
# 用於簽署 session cookie 的隨機字串（建議 32+ 字元）
ADMIN_SESSION_SECRET=random-secret-string-change-me
